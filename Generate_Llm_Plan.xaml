    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="InputText + DOWNLOAD + file_name 지원 버전&#xA;+ Stream 지원" Code="' Planner 응답 Parse&#xD;&#xA;' - 일반 OpenAI Compatible JSON 응답 지원&#xD;&#xA;' - stream=true SSE 응답 지원&#xD;&#xA;' - Streaming choices[0].delta.content 순차 결합&#xD;&#xA;' - finish_reason 검증&#xD;&#xA;' - max_tokens 도달(length) 감지&#xD;&#xA;' - 비정상 Streaming 중단 감지&#xD;&#xA;' - TYPE_INTO / CLICK / DOWNLOAD / CAPTURE Normalize&#xD;&#xA;&#xD;&#xA;Dim content As String = String.Empty&#xD;&#xA;Dim runtimePlanJson As String = String.Empty&#xD;&#xA;&#xD;&#xA;Try&#xD;&#xA;    If String.IsNullOrWhiteSpace(in_QwenRawResponse) Then&#xD;&#xA;        Throw New Exception(&quot;LLM raw response is empty&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim rawResponse As String = in_QwenRawResponse.Trim()&#xD;&#xA;&#xD;&#xA;    ' =========================================================&#xD;&#xA;    ' Streaming SSE 응답인지 판별&#xD;&#xA;    ' =========================================================&#xD;&#xA;    Dim isStreamingResponse As Boolean =&#xD;&#xA;        rawResponse.StartsWith(&quot;data:&quot;, StringComparison.OrdinalIgnoreCase) OrElse&#xD;&#xA;        rawResponse.IndexOf(Environment.NewLine &amp; &quot;data:&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0 OrElse&#xD;&#xA;        rawResponse.IndexOf(vbLf &amp; &quot;data:&quot;, StringComparison.OrdinalIgnoreCase) &gt;= 0&#xD;&#xA;&#xD;&#xA;    If isStreamingResponse Then&#xD;&#xA;        Dim contentBuilder As New System.Text.StringBuilder()&#xD;&#xA;        Dim finishReason As String = String.Empty&#xD;&#xA;        Dim receivedDone As Boolean = False&#xD;&#xA;        Dim streamChunkCount As Integer = 0&#xD;&#xA;&#xD;&#xA;        Dim normalizedRaw As String = rawResponse.Replace(vbCrLf, vbLf).Replace(vbCr, vbLf)&#xD;&#xA;        Dim lines As String() = normalizedRaw.Split(New String() {vbLf}, StringSplitOptions.None)&#xD;&#xA;&#xD;&#xA;        For Each rawLine As String In lines&#xD;&#xA;            If rawLine Is Nothing Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            Dim line As String = rawLine.Trim()&#xD;&#xA;&#xD;&#xA;            If String.IsNullOrWhiteSpace(line) Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            If Not line.StartsWith(&quot;data:&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            Dim dataText As String = line.Substring(5).Trim()&#xD;&#xA;&#xD;&#xA;            If String.IsNullOrWhiteSpace(dataText) Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            If String.Equals(dataText, &quot;[DONE]&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;                receivedDone = True&#xD;&#xA;                Exit For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            Dim chunk As Newtonsoft.Json.Linq.JObject = Nothing&#xD;&#xA;&#xD;&#xA;            Try&#xD;&#xA;                chunk = Newtonsoft.Json.Linq.JObject.Parse(dataText)&#xD;&#xA;            Catch chunkEx As Exception&#xD;&#xA;                Throw New Exception(&#xD;&#xA;                    &quot;Planner SSE chunk JSON 파싱에 실패했습니다. ChunkIndex=&quot; &amp;&#xD;&#xA;                    streamChunkCount.ToString() &amp;&#xD;&#xA;                    &quot;, Data=&quot; &amp;&#xD;&#xA;                    If(dataText.Length &gt; 500, dataText.Substring(0, 500), dataText),&#xD;&#xA;                    chunkEx&#xD;&#xA;                )&#xD;&#xA;            End Try&#xD;&#xA;&#xD;&#xA;            streamChunkCount += 1&#xD;&#xA;&#xD;&#xA;            Dim choices As Newtonsoft.Json.Linq.JArray =&#xD;&#xA;                TryCast(chunk(&quot;choices&quot;), Newtonsoft.Json.Linq.JArray)&#xD;&#xA;&#xD;&#xA;            If choices Is Nothing OrElse choices.Count = 0 Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            Dim firstChoice As Newtonsoft.Json.Linq.JToken = choices(0)&#xD;&#xA;&#xD;&#xA;            If firstChoice Is Nothing Then&#xD;&#xA;                Continue For&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            ' finish_reason 저장&#xD;&#xA;            If firstChoice(&quot;finish_reason&quot;) IsNot Nothing AndAlso&#xD;&#xA;               firstChoice(&quot;finish_reason&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xD;&#xA;&#xD;&#xA;                finishReason = Convert.ToString(firstChoice(&quot;finish_reason&quot;)).Trim()&#xD;&#xA;            End If&#xD;&#xA;&#xD;&#xA;            ' Streaming delta.content 결합&#xD;&#xA;            Dim delta As Newtonsoft.Json.Linq.JToken = firstChoice(&quot;delta&quot;)&#xD;&#xA;&#xD;&#xA;            If delta IsNot Nothing AndAlso&#xD;&#xA;               delta(&quot;content&quot;) IsNot Nothing AndAlso&#xD;&#xA;               delta(&quot;content&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xD;&#xA;&#xD;&#xA;                contentBuilder.Append(Convert.ToString(delta(&quot;content&quot;)))&#xD;&#xA;&#xD;&#xA;            ElseIf firstChoice(&quot;message&quot;) IsNot Nothing AndAlso&#xD;&#xA;                   firstChoice(&quot;message&quot;)(&quot;content&quot;) IsNot Nothing AndAlso&#xD;&#xA;                   firstChoice(&quot;message&quot;)(&quot;content&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xD;&#xA;&#xD;&#xA;                contentBuilder.Append(Convert.ToString(firstChoice(&quot;message&quot;)(&quot;content&quot;)))&#xD;&#xA;&#xD;&#xA;            ElseIf firstChoice(&quot;text&quot;) IsNot Nothing AndAlso&#xD;&#xA;                   firstChoice(&quot;text&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xD;&#xA;&#xD;&#xA;                contentBuilder.Append(Convert.ToString(firstChoice(&quot;text&quot;)))&#xD;&#xA;            End If&#xD;&#xA;        Next&#xD;&#xA;&#xD;&#xA;        content = contentBuilder.ToString().Trim()&#xD;&#xA;&#xD;&#xA;        ' =====================================================&#xD;&#xA;        ' Streaming 종료 상태 검증&#xD;&#xA;        ' =====================================================&#xD;&#xA;        If String.Equals(finishReason, &quot;length&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner 출력이 max_tokens 제한에 도달하여 중간에 잘렸습니다. &quot; &amp;&#xD;&#xA;                &quot;finish_reason=length, &quot; &amp;&#xD;&#xA;                &quot;ChunkCount=&quot; &amp; streamChunkCount.ToString() &amp;&#xD;&#xA;                &quot;, ContentLength=&quot; &amp; content.Length.ToString()&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If Not String.IsNullOrWhiteSpace(finishReason) AndAlso&#xD;&#xA;           Not String.Equals(finishReason, &quot;stop&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner Streaming이 정상 종료되지 않았습니다. &quot; &amp;&#xD;&#xA;                &quot;finish_reason=&quot; &amp; finishReason &amp;&#xD;&#xA;                &quot;, ChunkCount=&quot; &amp; streamChunkCount.ToString() &amp;&#xD;&#xA;                &quot;, ContentLength=&quot; &amp; content.Length.ToString()&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If Not receivedDone AndAlso String.IsNullOrWhiteSpace(finishReason) Then&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner Streaming 응답이 완료 신호 없이 중간에 종료되었습니다. &quot; &amp;&#xD;&#xA;                &quot;[DONE] 및 finish_reason을 확인하지 못했습니다. &quot; &amp;&#xD;&#xA;                &quot;ChunkCount=&quot; &amp; streamChunkCount.ToString() &amp;&#xD;&#xA;                &quot;, ContentLength=&quot; &amp; content.Length.ToString()&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If String.IsNullOrWhiteSpace(content) Then&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner streaming response contained no content. &quot; &amp;&#xD;&#xA;                &quot;ChunkCount=&quot; &amp; streamChunkCount.ToString() &amp;&#xD;&#xA;                &quot;, FinishReason=&quot; &amp; finishReason &amp;&#xD;&#xA;                &quot;, ReceivedDone=&quot; &amp; receivedDone.ToString()&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;    Else&#xD;&#xA;        ' =========================================================&#xD;&#xA;        ' Non-Streaming JSON 응답&#xD;&#xA;        ' =========================================================&#xD;&#xA;        Dim root As Newtonsoft.Json.Linq.JObject =&#xD;&#xA;            Newtonsoft.Json.Linq.JObject.Parse(rawResponse)&#xD;&#xA;&#xD;&#xA;        Dim choices As Newtonsoft.Json.Linq.JArray =&#xD;&#xA;            TryCast(root(&quot;choices&quot;), Newtonsoft.Json.Linq.JArray)&#xD;&#xA;&#xD;&#xA;        If choices Is Nothing OrElse choices.Count = 0 Then&#xD;&#xA;            Throw New Exception(&quot;Planner response choices is empty&quot;)&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        Dim firstChoice As Newtonsoft.Json.Linq.JToken = choices(0)&#xD;&#xA;&#xD;&#xA;        Dim finishReason As String = String.Empty&#xD;&#xA;&#xD;&#xA;        If firstChoice(&quot;finish_reason&quot;) IsNot Nothing AndAlso&#xD;&#xA;           firstChoice(&quot;finish_reason&quot;).Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xD;&#xA;&#xD;&#xA;            finishReason = Convert.ToString(firstChoice(&quot;finish_reason&quot;)).Trim()&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If String.Equals(finishReason, &quot;length&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner 출력이 max_tokens 제한에 도달하여 중간에 잘렸습니다. finish_reason=length&quot;&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If Not String.IsNullOrWhiteSpace(finishReason) AndAlso&#xD;&#xA;           Not String.Equals(finishReason, &quot;stop&quot;, StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner 응답이 정상 종료되지 않았습니다. finish_reason=&quot; &amp; finishReason&#xD;&#xA;            )&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        If firstChoice(&quot;message&quot;) IsNot Nothing AndAlso&#xD;&#xA;           firstChoice(&quot;message&quot;)(&quot;content&quot;) IsNot Nothing Then&#xD;&#xA;&#xD;&#xA;            content = Convert.ToString(firstChoice(&quot;message&quot;)(&quot;content&quot;))&#xD;&#xA;&#xD;&#xA;        ElseIf firstChoice(&quot;text&quot;) IsNot Nothing Then&#xD;&#xA;            content = Convert.ToString(firstChoice(&quot;text&quot;))&#xD;&#xA;        End If&#xD;&#xA;&#xD;&#xA;        content = content.Trim()&#xD;&#xA;&#xD;&#xA;        If String.IsNullOrWhiteSpace(content) Then&#xD;&#xA;            Throw New Exception(&quot;Planner response content is empty&quot;)&#xD;&#xA;        End If&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' =========================================================&#xD;&#xA;    ' Planner content 정리&#xD;&#xA;    ' =========================================================&#xD;&#xA;    content = System.Text.RegularExpressions.Regex.Replace(&#xD;&#xA;        content,&#xD;&#xA;        &quot;^```json\s*&quot;,&#xD;&#xA;        &quot;&quot;,&#xD;&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xD;&#xA;    )&#xD;&#xA;&#xD;&#xA;    content = System.Text.RegularExpressions.Regex.Replace(&#xD;&#xA;        content,&#xD;&#xA;        &quot;^```\s*&quot;,&#xD;&#xA;        &quot;&quot;,&#xD;&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xD;&#xA;    )&#xD;&#xA;&#xD;&#xA;    content = System.Text.RegularExpressions.Regex.Replace(&#xD;&#xA;        content,&#xD;&#xA;        &quot;\s*```$&quot;,&#xD;&#xA;        &quot;&quot;,&#xD;&#xA;        System.Text.RegularExpressions.RegexOptions.IgnoreCase&#xD;&#xA;    )&#xD;&#xA;&#xD;&#xA;    Dim jsonMatch As System.Text.RegularExpressions.Match =&#xD;&#xA;        System.Text.RegularExpressions.Regex.Match(content, &quot;\{[\s\S]*\}&quot;)&#xD;&#xA;&#xD;&#xA;    If jsonMatch.Success Then&#xD;&#xA;        content = jsonMatch.Value&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' =========================================================&#xD;&#xA;    ' Planner JSON Parse&#xD;&#xA;    ' =========================================================&#xD;&#xA;    Dim plan As Newtonsoft.Json.Linq.JObject = Nothing&#xD;&#xA;&#xD;&#xA;    Try&#xD;&#xA;        plan = Newtonsoft.Json.Linq.JObject.Parse(content)&#xD;&#xA;    Catch jsonEx As Exception&#xD;&#xA;        Throw New Exception(&#xD;&#xA;            &quot;Planner Content가 완전한 JSON이 아닙니다. &quot; &amp;&#xD;&#xA;            &quot;ContentLength=&quot; &amp; content.Length.ToString() &amp;&#xD;&#xA;            &quot;, ParseMessage=&quot; &amp; jsonEx.GetBaseException().Message,&#xD;&#xA;            jsonEx&#xD;&#xA;        )&#xD;&#xA;    End Try&#xD;&#xA;&#xD;&#xA;    Dim stepsArray As Newtonsoft.Json.Linq.JArray =&#xD;&#xA;        TryCast(plan(&quot;steps&quot;), Newtonsoft.Json.Linq.JArray)&#xD;&#xA;&#xD;&#xA;    If stepsArray Is Nothing OrElse stepsArray.Count = 0 Then&#xD;&#xA;        Throw New Exception(&quot;Planner output steps is empty&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    ' =========================================================&#xD;&#xA;    ' Step Normalize&#xD;&#xA;    ' =========================================================&#xD;&#xA;    Dim normalizedSteps As New Newtonsoft.Json.Linq.JArray()&#xD;&#xA;    Dim sourceIndex As Integer = 1&#xD;&#xA;&#xD;&#xA;    For Each stepToken As Newtonsoft.Json.Linq.JToken In stepsArray&#xD;&#xA;        Dim stepObj As Newtonsoft.Json.Linq.JObject =&#xD;&#xA;            TryCast(stepToken, Newtonsoft.Json.Linq.JObject)&#xD;&#xA;&#xD;&#xA;        If stepObj Is Nothing Then&#xD;&#xA;            Throw New Exception(&#xD;&#xA;                &quot;Planner step is no