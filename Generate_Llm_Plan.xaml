    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Planner용 OpenAI Compatible Streaming 요청 Body 생성&#xA;Dim root As New Newtonsoft.Json.Linq.JObject()&#xA;&#xA;root(&quot;model&quot;) = in_QwenModel&#xA;&#xA;Dim messages As New Newtonsoft.Json.Linq.JArray()&#xA;Dim msg As New Newtonsoft.Json.Linq.JObject()&#xA;&#xA;msg(&quot;role&quot;) = &quot;user&quot;&#xA;msg(&quot;content&quot;) = in_QwenPrompt&#xA;&#xA;messages.Add(msg)&#xA;&#xA;root(&quot;messages&quot;) = messages&#xA;root(&quot;temperature&quot;) = 0&#xA;root(&quot;max_tokens&quot;) = 30000&#xA;root(&quot;stream&quot;) = True&#xA;&#xA;out_QwenRequestBody = root.ToString(Newtonsoft.Json.Formatting.None)" DisplayName="Build Llm Request Body" sap:VirtualizedContainerService.HintSize="486,287" sap2010:WorkflowViewState.IdRef="InvokeCode_2">
