          <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="TYPE_INTO는 actual value 대신 value_key 사용&#xA;실제 runtime input value 반환 금지" Code="Dim controlCode As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_ControlCode),&#xA;        &quot;&quot;,&#xA;        in_ControlCode.Trim().ToUpperInvariant()&#xA;    )&#xA;&#xA;Dim objectiveText As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_ObjectiveText),&#xA;        &quot;&quot;,&#xA;        in_ObjectiveText.Trim()&#xA;    )&#xA;&#xA;Dim startUrl As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_StartUrl),&#xA;        &quot;&quot;,&#xA;        in_StartUrl.Trim()&#xA;    )&#xA;&#xA;Dim maxSteps As Integer =&#xA;    If(in_MaxSteps &lt;= 0, 10, in_MaxSteps)&#xA;&#xA;&#xA;If String.IsNullOrWhiteSpace(controlCode) Then&#xA;    Throw New Exception(&quot;in_ControlCode가 비어 있습니다.&quot;)&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(objectiveText) Then&#xA;    Throw New Exception(&quot;in_ObjectiveText가 비어 있습니다.&quot;)&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(startUrl) Then&#xA;    Throw New Exception(&quot;in_StartUrl이 비어 있습니다.&quot;)&#xA;End If&#xA;&#xA;&#xA;Dim sb As New System.Text.StringBuilder()&#xA;&#xA;&#xA;sb.AppendLine(&quot;You are an RPA planning agent.&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;Convert the user's business objective into an executable UiPath runtime action plan.&quot;&#xA;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 중요 규칙&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Important rules:&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Return JSON only.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not include markdown code fences.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not include explanations outside the JSON.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Use only the allowed operations.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Create exactly one executable UI action per step.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not merge multiple clicks or inputs into one step.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not create UiPath selectors.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not create CSS selectors or XPath expressions.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return screen coordinates.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return candidate_tags.&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- UI candidate discovery is performed independently by UiPath at runtime.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not restrict UI candidates by operation, HTML tag, control type, selector, XPath, CSS selector, or coordinate.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not invent credentials, passwords, authentication values, search values, dates, codes, or other runtime input values.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- For every TYPE_INTO step, use value_key instead of including the actual input value.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Generate value_key using the supplied control_code and a concise semantic value name.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- value_key must use uppercase snake case in the format &lt;CONTROL_CODE&gt;_&lt;SEMANTIC_VALUE_NAME&gt;.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Examples of valid value_key formats are &lt;CONTROL_CODE&gt;_USERNAME, &lt;CONTROL_CODE&gt;_PASSWORD, &lt;CONTROL_CODE&gt;_SEARCH_TEXT, and &lt;CONTROL_CODE&gt;_COMPANY_CODE.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&quot;- Do not include verification steps for now.&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not include VERIFY, CHECK, VALIDATE, WAIT, DELAY, OPEN_URL, or unsupported operations.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not include OPEN_URL because Main.xaml already opens the supplied start_url.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&quot;- The final step must always be CAPTURE.&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- The final CAPTURE step must use step_id S999.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Preserve the exact chronological order described in the objective.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Explicit sequence expressions such as &quot;&quot;먼저&quot;&quot;, &quot;&quot;후&quot;&quot;, &quot;&quot;다음&quot;&quot;, &quot;&quot;진입한 후&quot;&quot;, &quot;&quot;누른 후&quot;&quot;, &quot;&quot;before&quot;&quot;, &quot;&quot;after&quot;&quot;, and &quot;&quot;then&quot;&quot; are mandatory ordering constraints.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not omit prerequisite navigation steps required to reach the requested screen or control.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not assume that a required screen, form, menu, field, popup, tab, or dialog is already visible unless the objective clearly states that it is already open.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Preserve exact visible UI labels supplied in the objective.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not translate visible UI labels into another language.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- When the objective does not provide an exact visible UI label, use a concise semantic target description in the same language as the objective.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Generate action_key as a concise, stable, lowercase, dot-separated semantic identifier.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- action_key describes the meaning of the action and must not contain selectors, coordinates, runtime values, or long sentences.&quot;&#xA;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 허용 Operation&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Allowed operations:&quot;)&#xA;&#xA;sb.AppendLine(&quot;- TYPE_INTO&quot;)&#xA;&#xA;sb.AppendLine(&quot;- CLICK&quot;)&#xA;&#xA;sb.AppendLine(&quot;- CAPTURE&quot;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 단계별 출력 형식&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Step object formats:&quot;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' 일반 CLICK&#xA;sb.AppendLine(&quot;CLICK step:&quot;)&#xA;&#xA;sb.AppendLine(&quot;{&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;SXXX&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;CLICK&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;&lt;concise semantic action key&gt;&quot;&quot;,&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;&lt;exact visible UI label or concise semantic target description&gt;&quot;&quot;&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&quot;}&quot;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' 일반 TYPE_INTO&#xA;sb.AppendLine(&quot;TYPE_INTO step:&quot;)&#xA;&#xA;sb.AppendLine(&quot;{&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;SXXX&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;TYPE_INTO&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;&lt;concise semantic action key&gt;&quot;&quot;,&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;&lt;input field description&gt;&quot;&quot;,&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;value_key&quot;&quot;: &quot;&quot;&lt;CONTROL_CODE&gt;_&lt;SEMANTIC_VALUE_NAME&gt;&quot;&quot;,&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;value_kind&quot;&quot;: &quot;&quot;&lt;concise semantic value category&gt;&quot;&quot;&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&quot;}&quot;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' 최종 CAPTURE&#xA;sb.AppendLine(&quot;CAPTURE step:&quot;)&#xA;&#xA;sb.AppendLine(&quot;{&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;S999&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;CAPTURE&quot;&quot;,&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;evidence.capture&quot;&quot;,&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;  &quot;&quot;evidence_description&quot;&quot;: &quot;&quot;&lt;concise description of the screen being captured&gt;&quot;&quot;&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&quot;}&quot;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 계획 생성 지침&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Planning guidance:&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Decompose the objective into the smallest necessary executable UI actions.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Preserve every explicitly described navigation, input, submission, and menu-selection action.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Create prerequisite CLICK steps when a required form, menu, tab, popup, or screen must be opened before the next action.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not create navigation steps that are not required by the objective.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- For authentication flows, do not assume that credential fields are already visible.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- If the authentication form must be opened first, create the required CLICK step before credential TYPE_INTO steps.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- If the authentication form is explicitly stated to be already open, credential TYPE_INTO steps may begin immediately.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- When authentication requires multiple input fields, create a separate TYPE_INTO step for each field.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- After all required authentication values are entered, create a separate CLICK step for submission when submission is required.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Never merge authentication entry navigation and authentication submission into the same CLICK step.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- For username input, use &quot; &amp; controlCode &amp; &quot;_USERNAME as value_key.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- For password input, use &quot; &amp; controlCode &amp; &quot;_PASSWORD as value_key.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- For other runtime inputs, derive value_key from the supplied control_code and the semantic input name.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- value_kind must describe the input category using a concise lowercase value such as username, password, search_text, date, code, or general_text.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Keep the plan concise without removing required prerequisite actions.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not create intermediate CAPTURE steps unless the objective explicitly requires them.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- The final executable action must always be CAPTURE.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Maximum number of steps: &quot; &amp; maxSteps.ToString()&#xA;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 실행 입력&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Input:&quot;)&#xA;&#xA;sb.AppendLine(&quot;control_code: &quot; &amp; controlCode)&#xA;&#xA;sb.AppendLine(&quot;start_url: &quot; &amp; startUrl)&#xA;&#xA;sb.AppendLine(&quot;objective: &quot; &amp; objectiveText)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 최상위 JSON 구조&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Required top-level JSON fields:&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- control_code: use the supplied control_code exactly.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- plan_type: use QWEN_GENERATED_ACTION_PLAN.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- start_url: use the supplied start_url exactly.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- objective: preserve the supplied objective exactly.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- steps: a non-empty array of chronologically ordered executable step objects.&quot;&#xA;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 단계 번호 규칙&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Step numbering rules:&quot;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Number non-CAPTURE executable steps sequentially as S001, S002, S003, and so on.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not skip or duplicate sequential step numbers.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- Do not use S999 for CLICK or TYPE_INTO steps.&quot;&#xA;)&#xA;&#xA;sb.AppendLine(&#xA;    &quot;- CAPTURE must be the final step and must use step_id S999.&quot;&#xA;)&#xA;&#xA;sb.AppendLine()&#xA;&#xA;&#xA;' =========================================================&#xA;' 최종 출력 제한&#xA;' =========================================================&#xA;&#xA;sb.AppendLine(&quot;Final output restrictions:&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Return one valid JSON object only.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return comments.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return trailing text.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return markdown.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return candidate_tags.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return selectors.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return coordinates.&quot;)&#xA;&#xA;sb.AppendLine(&quot;- Do not return actual runtime input values.&quot;)&#xA;&#xA;&#xA;out_QwenPrompt = sb.ToString()" DisplayName="Build Planner Prompt" sap:VirtualizedContainerService.HintSize="416,323" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
