    <ui:InvokeCode ContinueOnError="{x:Null}" sap2010:Annotation.AnnotationText="objectiveText = Meta Procedure&#xA;TYPE_INTO → input_text에 따옴표 안 실제 문자열 복사&#xA;DOWNLOAD → 다운로드 대상과 선택적 file_name 생성&#xA;value_key → 당분간 빈 문자열&#xA;CLICK/CAPTURE/DOWNLOAD → input_text 빈 문자열" Code="Dim controlCode As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_ControlCode),&#xA;        String.Empty,&#xA;        in_ControlCode.Trim().ToUpperInvariant()&#xA;    )&#xA;&#xA;Dim metaProcedureText As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_ObjectiveText),&#xA;        String.Empty,&#xA;        in_ObjectiveText.Trim()&#xA;    )&#xA;&#xA;Dim startUrl As String =&#xA;    If(&#xA;        String.IsNullOrWhiteSpace(in_StartUrl),&#xA;        String.Empty,&#xA;        in_StartUrl.Trim()&#xA;    )&#xA;&#xA;Dim maxSteps As Integer =&#xA;    If(in_MaxSteps &lt;= 0, 10, in_MaxSteps)&#xA;&#xA;If String.IsNullOrWhiteSpace(controlCode) Then&#xA;    Throw New Exception(&quot;in_ControlCode가 비어 있습니다.&quot;)&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(metaProcedureText) Then&#xA;    Throw New Exception(&quot;in_ObjectiveText에 Meta Procedure가 없습니다.&quot;)&#xA;End If&#xA;&#xA;If String.IsNullOrWhiteSpace(startUrl) Then&#xA;    Throw New Exception(&quot;in_StartUrl이 비어 있습니다.&quot;)&#xA;End If&#xA;&#xA;Dim sb As New System.Text.StringBuilder()&#xA;&#xA;sb.AppendLine(&quot;You are an RPA planning agent.&quot;)&#xA;sb.AppendLine(&quot;Convert the supplied Meta Procedure into an executable UiPath runtime action plan.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Core interpretation rules:&quot;)&#xA;sb.AppendLine(&quot;- The supplied objective is a Meta Procedure containing ordered business instructions.&quot;)&#xA;sb.AppendLine(&quot;- Preserve the exact chronological order of the Meta Procedure.&quot;)&#xA;sb.AppendLine(&quot;- Treat expressions such as 먼저, 후, 다음, 진입한 후, 누른 후, before, after, and then as mandatory ordering constraints.&quot;)&#xA;sb.AppendLine(&quot;- Create exactly one executable UI action per step.&quot;)&#xA;sb.AppendLine(&quot;- Do not merge multiple clicks, inputs, downloads, or captures into one step.&quot;)&#xA;sb.AppendLine(&quot;- Do not omit explicitly described navigation, input, submission, menu-selection, download, save, or capture actions.&quot;)&#xA;sb.AppendLine(&quot;- Do not invent unnecessary navigation steps.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Output restrictions:&quot;)&#xA;sb.AppendLine(&quot;- Return one valid JSON object only.&quot;)&#xA;sb.AppendLine(&quot;- Do not return markdown code fences.&quot;)&#xA;sb.AppendLine(&quot;- Do not return explanations, comments, or trailing text.&quot;)&#xA;sb.AppendLine(&quot;- Do not return UiPath selectors.&quot;)&#xA;sb.AppendLine(&quot;- Do not return CSS selectors or XPath expressions.&quot;)&#xA;sb.AppendLine(&quot;- Do not return screen coordinates.&quot;)&#xA;sb.AppendLine(&quot;- Do not return candidate_tags.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Allowed operations:&quot;)&#xA;sb.AppendLine(&quot;- TYPE_INTO&quot;)&#xA;sb.AppendLine(&quot;- CLICK&quot;)&#xA;sb.AppendLine(&quot;- DOWNLOAD&quot;)&#xA;sb.AppendLine(&quot;- CAPTURE&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Forbidden operations:&quot;)&#xA;sb.AppendLine(&quot;- OPEN_URL&quot;)&#xA;sb.AppendLine(&quot;- VERIFY&quot;)&#xA;sb.AppendLine(&quot;- CHECK&quot;)&#xA;sb.AppendLine(&quot;- VALIDATE&quot;)&#xA;sb.AppendLine(&quot;- WAIT&quot;)&#xA;sb.AppendLine(&quot;- DELAY&quot;)&#xA;sb.AppendLine(&quot;- Main.xaml opens the supplied start_url, so do not generate OPEN_URL.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Required fields for every step object:&quot;)&#xA;sb.AppendLine(&quot;- step_id&quot;)&#xA;sb.AppendLine(&quot;- operation&quot;)&#xA;sb.AppendLine(&quot;- action_key&quot;)&#xA;sb.AppendLine(&quot;- target_description&quot;)&#xA;sb.AppendLine(&quot;- input_text&quot;)&#xA;sb.AppendLine(&quot;- value_key&quot;)&#xA;sb.AppendLine(&quot;- value_kind&quot;)&#xA;sb.AppendLine(&quot;- file_name&quot;)&#xA;sb.AppendLine(&quot;- evidence_description&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;TYPE_INTO rules:&quot;)&#xA;sb.AppendLine(&quot;- Every TYPE_INTO step must contain the input_text field.&quot;)&#xA;sb.AppendLine(&quot;- Copy the literal string written inside quotation marks in the Meta Procedure into input_text exactly.&quot;)&#xA;sb.AppendLine(&quot;- Do not summarize, translate, correct, mask, normalize, or modify the quoted input string.&quot;)&#xA;sb.AppendLine(&quot;- Do not invent an input value that is not explicitly present in the Meta Procedure.&quot;)&#xA;sb.AppendLine(&quot;- target_description must describe the destination input control, not the input value.&quot;)&#xA;sb.AppendLine(&quot;- Set value_key to an empty string for the current implementation.&quot;)&#xA;sb.AppendLine(&quot;- Set value_kind to TEXT for ordinary text.&quot;)&#xA;sb.AppendLine(&quot;- Set value_kind to SECRET for password or other secret input.&quot;)&#xA;sb.AppendLine(&quot;- Set file_name and evidence_description to empty strings.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;CLICK rules:&quot;)&#xA;sb.AppendLine(&quot;- target_description must describe the UI element to click.&quot;)&#xA;sb.AppendLine(&quot;- Do not use CLICK when the explicit purpose of the UI element is to download or save a file.&quot;)&#xA;sb.AppendLine(&quot;- Set input_text, value_key, value_kind, file_name, and evidence_description to empty strings.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;DOWNLOAD rules:&quot;)&#xA;sb.AppendLine(&quot;- Use DOWNLOAD when the Meta Procedure explicitly instructs downloading, exporting, saving, or receiving a file from the UI.&quot;)&#xA;sb.AppendLine(&quot;- Do not convert an explicit file download or file save action into CLICK.&quot;)&#xA;sb.AppendLine(&quot;- Create one DOWNLOAD step for the UI element that initiates the file download or save operation.&quot;)&#xA;sb.AppendLine(&quot;- target_description must describe the download, export, attachment, or save UI element to activate.&quot;)&#xA;sb.AppendLine(&quot;- If the Meta Procedure explicitly supplies a file name, copy it into file_name exactly.&quot;)&#xA;sb.AppendLine(&quot;- If no file name is explicitly supplied, set file_name to an empty string.&quot;)&#xA;sb.AppendLine(&quot;- Do not infer, translate, normalize, or invent a file name or file extension.&quot;)&#xA;sb.AppendLine(&quot;- Set input_text, value_key, value_kind, and evidence_description to empty strings.&quot;)&#xA;sb.AppendLine(&quot;- Do not decide whether the result is an automatic download, a browser dialog, or an operating-system Save As dialog.&quot;)&#xA;sb.AppendLine(&quot;- Do not generate additional steps for a browser download prompt or an operating-system Save As dialog.&quot;)&#xA;sb.AppendLine(&quot;- The runtime engine detects and handles the actual download result after activating the selected UI element.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;CAPTURE rules:&quot;)&#xA;sb.AppendLine(&quot;- Set target_description, input_text, value_key, value_kind, and file_name to empty strings.&quot;)&#xA;sb.AppendLine(&quot;- Write the screen or state to capture in evidence_description.&quot;)&#xA;sb.AppendLine(&quot;- The final step must always be CAPTURE.&quot;)&#xA;sb.AppendLine(&quot;- The final CAPTURE step must use step_id S999.&quot;)&#xA;sb.AppendLine(&quot;- Do not create intermediate CAPTURE steps unless explicitly required by the Meta Procedure.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Action key rules:&quot;)&#xA;sb.AppendLine(&quot;- action_key must be a concise, stable, lowercase, dot-separated semantic identifier.&quot;)&#xA;sb.AppendLine(&quot;- action_key must not contain selectors, coordinates, input values, file paths, or long sentences.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Target description rules:&quot;)&#xA;sb.AppendLine(&quot;- Preserve exact visible UI labels supplied in the Meta Procedure.&quot;)&#xA;sb.AppendLine(&quot;- Do not translate visible UI labels into another language.&quot;)&#xA;sb.AppendLine(&quot;- When an exact label is not supplied, use a concise semantic target description in the same language as the Meta Procedure.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Step object examples:&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;TYPE_INTO:&quot;)&#xA;sb.AppendLine(&quot;{&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;S001&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;TYPE_INTO&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;login.input.username&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;로그인 아이디 입력란&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;input_text&quot;&quot;: &quot;&quot;test_user&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_key&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_kind&quot;&quot;: &quot;&quot;TEXT&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;file_name&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;evidence_description&quot;&quot;: &quot;&quot;&quot;&quot;&quot;)&#xA;sb.AppendLine(&quot;}&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;CLICK:&quot;)&#xA;sb.AppendLine(&quot;{&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;S002&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;CLICK&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;login.submit&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;로그인 버튼&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;input_text&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_key&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_kind&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;file_name&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;evidence_description&quot;&quot;: &quot;&quot;&quot;&quot;&quot;)&#xA;sb.AppendLine(&quot;}&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;DOWNLOAD:&quot;)&#xA;sb.AppendLine(&quot;{&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;S003&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;DOWNLOAD&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;report.download.excel&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;조회 결과 엑셀 다운로드 버튼&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;input_text&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_key&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_kind&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;file_name&quot;&quot;: &quot;&quot;조회결과.xlsx&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;evidence_description&quot;&quot;: &quot;&quot;&quot;&quot;&quot;)&#xA;sb.AppendLine(&quot;}&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;CAPTURE:&quot;)&#xA;sb.AppendLine(&quot;{&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;step_id&quot;&quot;: &quot;&quot;S999&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;operation&quot;&quot;: &quot;&quot;CAPTURE&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;action_key&quot;&quot;: &quot;&quot;evidence.capture&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;target_description&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;input_text&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_key&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;value_kind&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;file_name&quot;&quot;: &quot;&quot;&quot;&quot;,&quot;)&#xA;sb.AppendLine(&quot;  &quot;&quot;evidence_description&quot;&quot;: &quot;&quot;최종 화면&quot;&quot;&quot;)&#xA;sb.AppendLine(&quot;}&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Required top-level JSON fields:&quot;)&#xA;sb.AppendLine(&quot;- control_code: preserve the supplied control_code exactly.&quot;)&#xA;sb.AppendLine(&quot;- plan_type: use QWEN_GENERATED_ACTION_PLAN.&quot;)&#xA;sb.AppendLine(&quot;- start_url: preserve the supplied start_url exactly.&quot;)&#xA;sb.AppendLine(&quot;- objective: preserve the supplied Meta Procedure exactly.&quot;)&#xA;sb.AppendLine(&quot;- steps: a non-empty array of chronologically ordered executable step objects.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Step numbering rules:&quot;)&#xA;sb.AppendLine(&quot;- Number non-CAPTURE steps sequentially as S001, S002, S003, and so on.&quot;)&#xA;sb.AppendLine(&quot;- Do not skip or duplicate sequential step numbers.&quot;)&#xA;sb.AppendLine(&quot;- Do not use S999 for CLICK, TYPE_INTO, or DOWNLOAD.&quot;)&#xA;sb.AppendLine(&quot;- The final CAPTURE step must use S999.&quot;)&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Maximum number of steps: &quot; &amp; maxSteps.ToString())&#xA;sb.AppendLine()&#xA;&#xA;sb.AppendLine(&quot;Input:&quot;)&#xA;sb.AppendLine(&quot;control_code: &quot; &amp; controlCode)&#xA;sb.AppendLine(&quot;start_url: &quot; &amp; startUrl)&#xA;sb.AppendLine(&quot;meta_procedure:&quot;)&#xA;sb.AppendLine(metaProcedureText)&#xA;&#xA;out_QwenPrompt = sb.ToString()" DisplayName="Build Planner Prompt" 