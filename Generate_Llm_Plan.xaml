    <ui:InvokeCode ContinueOnError="{x:Null}" Code="' Planner Streaming HTTP 호출&#xD;&#xA;' - stream=true 강제&#xD;&#xA;' - ResponseHeadersRead로 HTTP Header 수신 직후 Stream 읽기 시작&#xD;&#xA;' - text/event-stream 응답을 끝까지 실제 Raw SSE 형태로 보존&#xD;&#xA;' - 서버가 Streaming을 무시하고 일반 JSON을 반환하는 경우도 지원&#xD;&#xA;&#xD;&#xA;out_ResponseBody = String.Empty&#xD;&#xA;out_StatusCode = 0&#xD;&#xA;&#xD;&#xA;Try&#xD;&#xA;    Dim endpoint As String = Convert.ToString(in_Endpoint).Trim()&#xD;&#xA;    Dim bodyToSend As String = Convert.ToString(in_RequestBody)&#xD;&#xA;    Dim apiKey As String = Convert.ToString(in_ApiKey).Trim()&#xD;&#xA;&#xD;&#xA;    If String.IsNullOrWhiteSpace(endpoint) Then&#xD;&#xA;        Throw New System.Exception(&quot;Qwen endpoint is empty&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    If String.IsNullOrWhiteSpace(bodyToSend) Then&#xD;&#xA;        Throw New System.Exception(&quot;Qwen request body is empty&quot;)&#xD;&#xA;    End If&#xD;&#xA;&#xD;&#xA;    Dim requestJson As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(bodyToSend)&#xD;&#xA;&#xD;&#xA;    ' Planner는 Streaming 방식으로 호출&#xD;&#xA;    requestJson(&quot;stream&quot;) = True&#xD;&#xA;    bodyToSend = requestJson.ToString(Newtonsoft.Json.Formatting.None)&#xD;&#xA;&#xD;&#xA;    System.Net.ServicePointManager.SecurityProtocol = System.Net.SecurityProtocolType.Tls12&#xD;&#xA;&#xD;&#xA;    Using handler As New System.Net.Http.HttpClientHandler()&#xD;&#xA;        handler.UseDefaultCredentials = False&#xD;&#xA;        handler.PreAuthenticate = False&#xD;&#xA;        handler.UseCookies = False&#xD;&#xA;        handler.AllowAutoRedirect = True&#xD;&#xA;&#xD;&#xA;        Using client As New System.Net.Http.HttpClient(handler)&#xD;&#xA;            client.Timeout = System.TimeSpan.FromMinutes(10)&#xD;&#xA;&#xD;&#xA;            Using request As New System.Net.Http.HttpRequestMessage(System.Net.Http.HttpMethod.Post, endpoint)&#xD;&#xA;                request.Headers.Accept.Clear()&#xD;&#xA;                request.Headers.Accept.Add(New System.Net.Http.Headers.MediaTypeWithQualityHeaderValue(&quot;text/event-stream&quot;))&#xD;&#xA;                request.Headers.ExpectContinue = False&#xD;&#xA;&#xD;&#xA;                If Not String.IsNullOrWhiteSpace(apiKey) AndAlso Not String.Equals(apiKey, &quot;EMPTY&quot;, System.StringComparison.OrdinalIgnoreCase) Then&#xD;&#xA;                    request.Headers.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, apiKey)&#xD;&#xA;                End If&#xD;&#xA;&#xD;&#xA;                request.Content = New System.Net.Http.StringContent(bodyToSend, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xD;&#xA;&#xD;&#xA;                Using response As System.Net.Http.HttpResponseMessage = client.SendAsync(request, System.Net.Http.HttpCompletionOption.ResponseHeadersRead).GetAwaiter().GetResult()&#xD;&#xA;                    out_StatusCode = CInt(response.StatusCode)&#xD;&#xA;&#xD;&#xA;                    If Not response.IsSuccessStatusCode Then&#xD;&#xA;                        Dim errorBody As String = String.Empty&#xD;&#xA;&#xD;&#xA;                        If response.Content IsNot Nothing Then&#xD;&#xA;                            errorBody = response.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xD;&#xA;                        End If&#xD;&#xA;&#xD;&#xA;                        out_ResponseBody = &quot;Qwen API returned HTTP &quot; &amp; out_StatusCode.ToString() &amp; &quot; &quot; &amp; Convert.ToString(response.ReasonPhrase) &amp; Environment.NewLine &amp; errorBody&#xD;&#xA;                    Else&#xD;&#xA;                        Dim mediaType As String = String.Empty&#xD;&#xA;&#xD;&#xA;                        If response.Content IsNot Nothing AndAlso response.Content.Headers IsNot Nothing AndAlso response.Content.Headers.ContentType IsNot Nothing Then&#xD;&#xA;                            mediaType = Convert.ToString(response.Content.Headers.ContentType.MediaType)&#xD;&#xA;                        End If&#xD;&#xA;&#xD;&#xA;                        If mediaType.IndexOf(&quot;text/event-stream&quot;, System.StringComparison.OrdinalIgnoreCase) &gt;= 0 Then&#xD;&#xA;                            Dim rawBuilder As New System.Text.StringBuilder()&#xD;&#xA;&#xD;&#xA;                            Using responseStream As System.IO.Stream = response.Content.ReadAsStreamAsync().GetAwaiter().GetResult()&#xD;&#xA;                                Using reader As New System.IO.StreamReader(responseStream, System.Text.Encoding.UTF8)&#xD;&#xA;                                    While Not reader.EndOfStream&#xD;&#xA;                                        Dim line As String = reader.ReadLine()&#xD;&#xA;&#xD;&#xA;                                        If line Is Nothing Then&#xD;&#xA;                                            Exit While&#xD;&#xA;                                        End If&#xD;&#xA;&#xD;&#xA;                                        rawBuilder.AppendLine(line)&#xD;&#xA;                                    End While&#xD;&#xA;                                End Using&#xD;&#xA;                            End Using&#xD;&#xA;&#xD;&#xA;                            out_ResponseBody = rawBuilder.ToString()&#xD;&#xA;                        Else&#xD;&#xA;                            ' 서버가 stream=true를 무시하고 일반 JSON을 반환하는 경우&#xD;&#xA;                            If response.Content IsNot Nothing Then&#xD;&#xA;                                out_ResponseBody = response.Content.ReadAsStringAsync().GetAwaiter().GetResult()&#xD;&#xA;                            End If&#xD;&#xA;                        End If&#xD;&#xA;                    End If&#xD;&#xA;                End Using&#xD;&#xA;            End Using&#xD;&#xA;        End Using&#xD;&#xA;    End Using&#xD;&#xA;&#xD;&#xA;Catch ex As System.Threading.Tasks.TaskCanceledException&#xD;&#xA;    out_StatusCode = -2&#xD;&#xA;    out_ResponseBody = &quot;Qwen Planner HTTP Timeout&quot; &amp; Environment.NewLine