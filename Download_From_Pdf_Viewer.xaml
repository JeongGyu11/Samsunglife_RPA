          <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="Chrome 다운로드 UI 후보 제외" sap2010:WorkflowViewState.IdRef="InvokeCode_ExcludeChromeDownloadUi_1" Code="Dim root = Newtonsoft.Json.Linq.JObject.Parse(candidateJsonText)&#xA;Dim source = TryCast(root(&quot;candidates&quot;), Newtonsoft.Json.Linq.JArray)&#xA;If source Is Nothing Then Throw New Exception(&quot;PDF candidates 배열이 없습니다.&quot;)&#xA;&#xA;Dim cleaned As New Newtonsoft.Json.Linq.JArray()&#xA;For Each token As Newtonsoft.Json.Linq.JToken In source&#xA;    Dim nameHint As String = System.Convert.ToString(token(&quot;name_hint&quot;)).Trim().ToLowerInvariant()&#xA;    Dim itemText As String = System.Convert.ToString(token(&quot;text&quot;)).Trim().ToLowerInvariant()&#xA;    Dim ariaLabel As String = System.Convert.ToString(token(&quot;aria_label&quot;)).Trim().ToLowerInvariant()&#xA;    Dim combinedName As String = nameHint &amp; &quot; &quot; &amp; itemText &amp; &quot; &quot; &amp; ariaLabel&#xA;&#xA;    Dim isChromeDownloadUi As Boolean =&#xA;        combinedName.Contains(&quot;새 다운로드 사용 가능&quot;) OrElse&#xA;        combinedName.Contains(&quot;recent downloads&quot;) OrElse&#xA;        combinedName.Contains(&quot;최근 다운로드 기록&quot;) OrElse&#xA;        combinedName.Contains(&quot;downloads bubble&quot;)&#xA;&#xA;    If Not isChromeDownloadUi Then cleaned.Add(token.DeepClone())&#xA;Next&#xA;&#xA;root(&quot;candidates&quot;) = cleaned&#xA;root(&quot;candidate_count&quot;) = cleaned.Count&#xA;candidateJsonText = root.ToString(Newtonsoft.Json.Formatting.None)&#xA;candidateCountValue = cleaned.Count">
            <ui:InvokeCode.Arguments>
