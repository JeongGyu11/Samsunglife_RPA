          <ui:InvokeCode ContinueOnError="{x:Null}" DisplayName="PDF 다운로드 후보 정제" sap2010:WorkflowViewState.IdRef="InvokeCode_FilterPdfCandidates_1" Code="Dim root = Newtonsoft.Json.Linq.JObject.Parse(in_Json)&#xA;Dim source = TryCast(root(&quot;candidates&quot;), Newtonsoft.Json.Linq.JArray)&#xA;If source Is Nothing Then Throw New Exception(&quot;PDF candidates 배열이 없습니다.&quot;)&#xA;Dim keywordMatches As New Newtonsoft.Json.Linq.JArray()&#xA;Dim pdfViewerMatches As New Newtonsoft.Json.Linq.JArray()&#xA;Dim buttonMatches As New Newtonsoft.Json.Linq.JArray()&#xA;For Each token As Newtonsoft.Json.Linq.JToken In source&#xA;    Dim combined As String = token.ToString(Newtonsoft.Json.Formatting.None).ToLowerInvariant()&#xA;    Dim role As String = System.Convert.ToString(token(&quot;role&quot;)).ToLowerInvariant()&#xA;    Dim itemText As String = System.Convert.ToString(token(&quot;text&quot;)).Trim()&#xA;    Dim nameHint As String = System.Convert.ToString(token(&quot;name_hint&quot;)).ToLowerInvariant()&#xA;    If combined.Contains(&quot;download&quot;) OrElse combined.Contains(&quot;다운로드&quot;) OrElse combined.Contains(&quot;save&quot;) OrElse combined.Contains(&quot;저장&quot;) Then&#xA;        keywordMatches.Add(token.DeepClone())&#xA;        If role = &quot;단추&quot; OrElse (String.IsNullOrWhiteSpace(itemText) AndAlso (nameHint.Contains(&quot;download&quot;) OrElse nameHint.Contains(&quot;다운로드&quot;))) Then pdfViewerMatches.Add(token.DeepClone())&#xA;    ElseIf role.Contains(&quot;push button&quot;) OrElse role = &quot;button&quot; Then&#xA;        buttonMatches.Add(token.DeepClone())&#xA;    End If&#xA;Next&#xA;Dim filtered As Newtonsoft.Json.Linq.JArray&#xA;If pdfViewerMatches.Count &gt; 0 Then&#xA;    filtered = pdfViewerMatches&#xA;    While filtered.Count &gt; 1&#xA;        filtered.RemoveAt(0)&#xA;    End While&#xA;ElseIf keywordMatches.Count &gt; 0 Then&#xA;    filtered = keywordMatches&#xA;    While filtered.Count &gt; 40&#xA;        filtered.RemoveAt(filtered.Count - 1)&#xA;    End While&#xA;Else&#xA;    filtered = buttonMatches&#xA;    If filtered.Count = 0 Then filtered = source&#xA;    While filtered.Count &gt; 60&#xA;        filtered.RemoveAt(0)&#xA;    End While&#xA;End If&#xA;root(&quot;candidates&quot;) = filtered&#xA;root(&quot;candidate_count&quot;) = filtered.Count&#xA;out_Json = root.ToString(Newtonsoft.Json.Formatting.None)&#xA;out_Count = filtered.Count">
